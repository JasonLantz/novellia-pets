      "from": "api",
      "to": "db",
      "label": "insert",
      "labelAt": [
        315,
        200
      ]
    },
    {
      "id": "seed-db",
      "from": "seed",
      "to": "db",
      "label": "demo rows"
    },
    {
      "id": "db-retrieve",
      "from": "db",
      "to": "retrieve",
      "label": "records",
      "fromSide": "right",
      "toSide": "left",
      "labelAt": [
        430,
        420
      ]
    },
    {
      "id": "guard-prompt",
      "from": "guard",
      "to": "prompt",
      "label": "in-scope"
    },
    {
      "id": "retrieve-prompt",
      "from": "retrieve",
      "to": "prompt",
      "label": "evidence lines"
    },
    {
      "id": "prompt-model",
      "from": "prompt",
      "to": "model",
      "label": "ChatML"
    },
    {
      "id": "model-chat",
      "from": "model",
      "to": "chat",
      "label": "answer",
      "labelAt": [
        960,
        200
      ]
    },
    {
      "id": "retrieve-fast",
      "from": "retrieve",
      "to": "fast",
      "label": "intent matched"
    },
    {
      "id": "fast-chat",
      "from": "fast",
      "to": "chat",
      "label": "exact answer"
    }
  ]
