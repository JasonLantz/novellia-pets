{
  "name": "novellia-pets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3300",
    "lint": "eslint",
    "evals": "tsx evals/run.mts",
    "evals:typecheck": "tsc -p tsconfig.evals.json",
    "evals:server": "EVAL_BASE_URL=http://localhost:3000 tsx evals/run.mts",
    "test": "tsx --test \"tests/*.test.ts\"",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:build": "docker build -t novellia-pets:latest .",
    "docker:tag": "docker tag novellia-pets:latest 192.168.0.25:5000/novellia-pets:latest",
    "docker:push": "docker push 192.168.0.25:5000/novellia-pets:latest",
    "docker:deploy": "npm run docker:build && npm run docker:tag && npm run docker:push",
    "k3s:restart": "kubectl rollout restart deployment/novellia-pets",
    "deploy": "npm run docker:deploy && npm run k3s:restart"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.157",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/transformers": "^4.3.1",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-table": "^9.3.1",
    "ai": "^7.0.153",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}